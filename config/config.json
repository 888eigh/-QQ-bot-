#模型默认使用deepseek格式，请根据需要自行修改
{
  "api_base_url": "https://api.deepseek.com",
  "api_key": "none",#请自行配置密钥
  "api_model": "deepseek-v4-flash",
  "api_timeout": 60,#返回值等待时间
